{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["custom/menu", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "wireplumber#output",
    "wireplumber#mic",
    "custom/vpn",
    "network",
    "bluetooth",
    "cpu",
  ],
  "custom/menu": {
    "format": "󰗀",
    "on-click": "launcher root",
    "on-right-click": "launcher apps",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "cursor": "pointer",
    "format": "{icon}",
    "format-icons": {
      "default": "{name}",
      "1": "1",
      "2": "2",
      "3": "3",
      "4": "4",
      "active": "󱓻",
    },
    "tooltips": {
      "default": "Workspace {name}",
      "active": "Workspace {name} (Active)",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
    },
  },
  "clock": {
    "format": "{:%A %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "weekdays": "<span color='#7f849c'>{}</span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "today": "<span color='#89b4fa'><b>{}</b></span>",
      },
    },
  },
  "cpu": {
    "format": "<span foreground='#a6e3a1'></span> {icon}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": {
      "mid": 50,
      "high": 80,
    },
    "on-click": "alacritty --title float -e btop",
    "interval": 2,
  },
  "wireplumber#output": {
    "node-type": "Audio/Sink",
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "{node_name}\nVolume: {volume}%",
    "on-click": "alacritty --title float -e wiremix -v output",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "max-volume": 100,
    "cursor": "pointer",
  },
  "wireplumber#mic": {
    "node-type": "Audio/Source",
    "format": "{icon}",
    "format-muted": "󰍭",
    "format-icons": ["󰍮", "󰍬"],
    "tooltip-format": "{node_name}\nVolume: {volume}%",
    "on-click": "alacritty --title float -e wiremix -v input",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "scroll-step": 5,
    "max-volume": 100,
    "cursor": "pointer",
  },
  "custom/vpn": {
    "exec": "vpn-tracker",
    "return-type": "json",
    "format": "{}",
    "on-click": "alacritty --title float -e vpn",
    "restart-interval": 5,
    "exec-on-event": false,
    "cursor": "pointer",
  },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-linked": "󰈂",
    "format-disconnected": "󰤭",
    "format-disabled": "󰤮",
    "on-click": "alacritty --title float -e wlctl",
    "tooltip-format-wifi": "{essid} {signalStrength}% ({frequency}GHz)\n⬆ {bandwidthUpBits} ⬇ {bandwidthDownBits}",
    "tooltip-format-ethernet": "{ifname}\n⬆ {bandwidthUpBits} ⬇ {bandwidthDownBits}",
    "tooltip-format-linked": "{ifname}\nno IP",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Network disabled",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "on-click": "alacritty --title float -e bluetui",
    "tooltip-format": "Bluetooth {status}",
    "tooltip-format-on": "No devices connected",
    "tooltip-format-off": "Bluetooth turned off",
    "tooltip-format-disabled": "Bluetooth disabled",
    "tooltip-format-no-controller": "No Bluetooth adapter",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
  },
  "tray": {
    "spacing": 24,
  },
}
