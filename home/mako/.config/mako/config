font=FiraCode Nerd Font 13px

background-color=#1e1e2ef2
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #45475a

border-size=2
border-radius=9

width=340
height=150
margin=8
padding=12

anchor=top-right
layer=overlay

icons=1
max-icon-size=32
icon-location=left

format=<b>%s</b>\n%b

default-timeout=5000
max-visible=4
max-history=50

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1
