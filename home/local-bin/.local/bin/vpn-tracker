#!/usr/bin/env fish

set -g previous unknown
set -g current unknown
set -g location ''

function publish
    set -l state "$current"
    if test "$state" = unknown
        set state "$previous"
    end
    set -l icon '󰌙'
    if test "$state" = connected
        set icon '󰒃'
    end
    set -l tooltip 'Loading…'
    if test -n "$location"
        set tooltip "$location"
    end
    jq -cn --arg text "$icon" --arg class "$state" --arg tooltip "$tooltip" \
        '{text: $text, class: $class, tooltip: $tooltip}'
end

function update --argument-names line
    if string match -rq '^\s*Visible location(?: \(new\))?:' -- "$line"
        contains -- "$current" connected disconnected; or return
        set -l next_location (string replace -r '^\s*Visible location(?: \(new\))?:\s*' '' -- "$line" \
            | string replace -r '\.\s+IPv[46]:.*$' '' | string trim)
        test "$location" = "$next_location"; and return
        set location "$next_location"
        publish
        return
    end

    if string match -q 'Connected*' -- "$line"
        set current connected
    else if string match -q 'Disconnected*' -- "$line"
        set current disconnected
    else if string match -rq '^(Connecting|Disconnecting|Reconnecting|Blocked|Error)' -- "$line"
        set current unknown
        set location ''
        publish
        return
    else
        return
    end

    test "$previous" = "$current"; and return
    set location ''
    publish

    if test "$current" = connected
        if test "$previous" != unknown
            awob send --preempt \
                --icon network-vpn \
                --accent '#b4befe' \
                --app 'VPN connected' \
                vpn 100 100 >/dev/null
        end
    else
        if test "$previous" != unknown
            awob send --preempt \
                --icon network-vpn-disconnected \
                --accent '#6c7086' \
                --app 'VPN disconnected' \
                vpn 0 100 >/dev/null
        end
    end

    set -g previous $current
end

mullvad status listen | while read -l line
    update "$line"
end
