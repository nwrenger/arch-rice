#!/usr/bin/env fish
# args: System, Flatpak

switch "$argv[1]"
    case "System"
        alacritty --title "float" -e fish -c "
            set -l pkg (fzf_pick '󰆴' 'system' 'pacman -Qi' 'pacman -Qeq'); or exit \$status
            set -q pkg[1]; or exit 0
            sudo pacman -Rns -- \$pkg
            show_done \$status"
    case "Flatpak"
        alacritty --title "float" -e fish -c "
            set -l apps (fzf_pick '󰆴' 'flatpak' 'flatpak info --{3}' \
                'flatpak list --app --user --system --columns=ref:f,name:f,installation:f' \
                --delimiter=\t --with-nth=2 --accept-nth=1,3); or exit \$status
            set -q apps[1]; or exit 0

            set -l user_refs
            set -l system_refs
            for app in \$apps
                set -l fields (string split -m1 \t -- \"\$app\")
                switch \$fields[2]
                    case user
                        set -a user_refs \$fields[1]
                    case system
                        set -a system_refs \$fields[1]
                    case '*'
                        echo 'remove: unsupported Flatpak installation' >&2
                        exit 1
                end
            end

            if set -q user_refs[1]
                flatpak uninstall --user --app \$user_refs; or exit \$status
            end
            if set -q system_refs[1]
                flatpak uninstall --system --app \$system_refs; or exit \$status
            end
            show_done 0"
    case '*'
        echo 'Usage: remove System|Flatpak' >&2
        exit 2
end
